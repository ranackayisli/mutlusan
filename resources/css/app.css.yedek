/*
 * Mutlusan Electric — stil giriş noktası.
 * Yeni stil eklerken ilgili dosyaya ekle; bu dosyaya doğrudan kural yazma.
 */
@import "tailwindcss";

@import "./base.css";
@import "./components/header.css";
@import "./components/hero.css";
@import "./components/chatbot.css";
@import "./sections/stats-strip.css";
@import "./sections/product-wheel.css";
@import "./pages/about.css";
@import "./pages/salt.css";

@theme {
  --color-mutlusan-red: #9E1F36;
  --color-mutlusan-red-dark: #6E1526;
  --color-mutlusan-red-light: #C33A54;
  --color-mutlusan-gray: #58595B;
  --color-mutlusan-gray-dark: #2E2F31;
  --color-mutlusan-gray-light: #F4F4F5;

  --font-display: "Manrope", "Inter", sans-serif;
  --font-body: "Inter", sans-serif;
}
